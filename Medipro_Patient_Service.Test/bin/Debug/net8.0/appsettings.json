{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "Keycloak": {
    "realm": "medipro",
    "auth-server-url": "http://localhost:9090/",
    "ssl-required": "none",
    "resource": "medipro",
    "verify-token-audience": false,
    "credentials": {
      "secret": ""
    },
