  },
  "Authentication": {
    "MetadataAddress": "http://localhost:9090/realms/medipro/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:9090/realms/medipro",
    "Audience": "account"
  },
  "ExternalApi": {
    "BaseUrl": "https://localhost"
  },
  "HttpClientName": {
    "AppointmentClient": "AppointmentServiceApi",
    "EmailClient": "EmailServiceApi",
  },
